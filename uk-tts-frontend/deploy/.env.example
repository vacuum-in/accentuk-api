# The stack's settings. deploy/install.sh writes deploy/.env from this file
# with the absolute path of the assets it downloads; to set it up by hand,
# copy it to deploy/.env and point the paths at your copies.

# Compose project and the lexicon's volume. Two stacks on one host need
# different values for both, and different ports below.
COMPOSE_PROJECT_NAME=uk-tts
POSTGRES_VOLUME=deploy_postgres-data
# Tag of the images this stack builds (uk-tts-<service>:<tag>).
IMAGE_TAG=latest

# The ukstress checkout (lexicon schema, stress API, model service).
UKSTRESS_DIR=../../wiki-stress

# Models, from Hugging Face (install.sh fetches them into the assets folder):
#   aloudreader/uk-stress-crossencoder      -> stress-model/ (checkpoint/ + serving_manifest.json)
#   aloudreader/uk-stress-token-classifier  -> tok-v5/
#   aloudreader/uk-stress-combiner          -> combiner-v1/
#   uk_core_news_trf 3.8.0 (explosion/spacy-models release) -> spacy-uk_core_news_trf/
#   aloudreader/marian-uk-verbalizer-spans-ct2-int8 (E60, reads one span at a time) -> verbalizer-spans/
#   (the whole-sentence E54, aloudreader/marian-uk-verbalizer, still works: point VERBALIZER_CHECKPOINT at it)
STRESS_MODEL_DIR=../../assets/stress-model
SERVING_MANIFEST=../../assets/stress-model/serving_manifest.json
TOKEN_MODEL_DIR=../../assets/tok-v5
COMBINER_DIR=../../assets/combiner-v1
SPACY_MODEL_DIR=../../assets/spacy-uk_core_news_trf
VERBALIZER_CHECKPOINT=../../assets/verbalizer-spans

# Lexicon tables the API reads (lexicon-assets.tar.gz of the data release).
SUFFIX_TABLE=../../assets/lexicon/suffix_table.json
TRIE_DEFAULTS=../../assets/lexicon/trie_defaults_map.json
COUNTED_FORM_LIST=../../assets/lexicon/counted_forms.json

# Must equal the manifest's own `inventory_hash`, or the API refuses the model.
ACTIVE_INVENTORY_HASH=759baefd94a6d8bc865f0a93ff378542b7a2b65dd58617c3194bdf85746c2769

# The served configuration: counted form after два/три/чотири, the lexicon
# layers read beside the active dataset (12 and 13 are reviewed corrections),
# and the learned combiner off unless a request asks ("combiner": true).
COUNTED_FORM=1
SUPPLEMENTARY_DATASETS=5,7,9,10,12,13,16
COMBINER_ENABLED=0
MODEL_THREADS=4

# The stress-model container reads mounted checkpoints owned by this uid.
HOST_UID=1000
HOST_GID=1000

# Ports and credentials.
FRONTEND_PORT=8000
STRESS_API_PORT=8080
UI_PORT=7861
POSTGRES_PORT=5432
POSTGRES_PASSWORD=ukstress_owner
API_PASSWORD=ukstress_api
